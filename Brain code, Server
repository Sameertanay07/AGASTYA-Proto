// ============================================================
// WEB DATA API
// ============================================================

void handleData() {
  String statusA = getNodeStatus(nodeA);
  String statusB = getNodeStatus(nodeB);
  
  String systemStatus = "STABLE";
  
  if (statusA == "CRITICAL" || statusB == "CRITICAL") {
    systemStatus = "CRITICAL";
  }
  else if (statusA == "WARNING" || statusB == "WARNING") {
    systemStatus = "WARNING";
  }
  else if (statusA == "WAITING" || statusB == "WAITING") {
    systemStatus = "WAITING";
  }
  else if (statusA == "OFFLINE" && statusB == "OFFLINE") {
    systemStatus = "OFFLINE";
  }
  
  String json = "{";
  
  json += "\"A\":{";
  json += "\"gx\":" + String(nodeA.gyroX, 3);
  json += ",\"gy\":" + String(nodeA.gyroY, 3);
  json += ",\"gz\":" + String(nodeA.gyroZ, 3);
  json += ",\"altitudeStatus\":\"" + getAltitudeStatus(nodeA.altitudeState) + "\"";
  json += ",\"status\":\"" + statusA + "\"";
  json += "},";
  
  json += "\"B\":{";
  json += "\"gx\":" + String(nodeB.gyroX, 3);
  json += ",\"gy\":" + String(nodeB.gyroY, 3);
  json += ",\"gz\":" + String(nodeB.gyroZ, 3);
  json += ",\"altitudeStatus\":\"" + getAltitudeStatus(nodeB.altitudeState) + "\"";
  json += ",\"status\":\"" + statusB + "\"";
  json += "},";
  
  json += "\"system\":\"" + systemStatus + "\"";
  json += "}";
  
  server.send(200, "application/json", json);
}

// ============================================================
// SETUP FUNCTIONS
// ============================================================

void setupWebServer() {
  server.on("/", []() {
    server.send(200, "text/html", webpage);
  });
  
  server.on("/data", handleData);
  
  server.begin();
}

void setupWiFi() {
  WiFi.mode(WIFI_AP_STA);
  delay(100);
  
  WiFi.softAP(AP_NAME, AP_PASSWORD, WIFI_CHANNEL);
  esp_wifi_set_channel(WIFI_CHANNEL, WIFI_SECOND_CHAN_NONE);
  
  Serial.print("Node C MAC: ");
  Serial.println(WiFi.macAddress());
  Serial.print("Dashboard IP: ");
  Serial.println(WiFi.softAPIP());
}

void setupESPNow() {
  if (esp_now_init() != ESP_OK) {
    Serial.println("ERROR: ESP-NOW INIT FAILED");
    while (true) { delay(1000); }
  }
  
  esp_now_register_recv_cb(onDataRecv);
  Serial.println("ESP-NOW READY");
}

// ============================================================
// SETUP
// ============================================================

void setup() {
  Serial.begin(115200);
  delay(1000);
  
  Serial.println();
  Serial.println("========================================");
  Serial.println("          NODE C - ESP32 DEVKIT");
  Serial.println("========================================");
  
  setupWiFi();
  setupESPNow();
  setupWebServer();
  
  Serial.println();
  Serial.println("Dashboard: http://" + WiFi.softAPIP().toString());
  Serial.println("Waiting for NODE A and NODE B...");
}

// ============================================================
// LOOP
// ============================================================

void loop() {
  server.handleClient();
}
