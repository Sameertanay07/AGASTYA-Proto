// ============================================================
// PACKET STRUCTURE
// ============================================================

typedef struct {
  char nodeID[8];
  uint32_t sequence;
  uint32_t timestamp;
  float gyroX;
  float gyroY;
  float gyroZ;
  float roll;
  float pitch;
  float yaw;
  uint8_t altitudeState;
  float relativeHeightCM;
  float baselinePressure;
} SensorPacket;

// ============================================================
// NODE DATA
// ============================================================

struct NodeData {
  bool received;
  float gyroX;
  float gyroY;
  float gyroZ;
  float roll;
  float pitch;
  uint8_t altitudeState;
  uint32_t sequence;
  unsigned long lastReceived;
};

NodeData nodeA = {};
NodeData nodeB = {};

// ============================================================
// RECEIVE CALLBACK
// ============================================================

void onDataRecv(const esp_now_recv_info_t *info, const uint8_t *data, int len) {
  if (len != sizeof(SensorPacket)) return;
  
  SensorPacket packet;
  memcpy(&packet, data, sizeof(SensorPacket));
  
  if (strcmp(packet.nodeID, "NODE_A") == 0) {
    nodeA.received = true;
    nodeA.gyroX = packet.gyroX;
    nodeA.gyroY = packet.gyroY;
    nodeA.gyroZ = packet.gyroZ;
    nodeA.roll = packet.roll;
    nodeA.pitch = packet.pitch;
    nodeA.altitudeState = packet.altitudeState;
    nodeA.sequence = packet.sequence;
    nodeA.lastReceived = millis();
    
    sendToProcessing("A", packet);
  }
  else if (strcmp(packet.nodeID, "NODE_B") == 0) {
    nodeB.received = true;
    nodeB.gyroX = packet.gyroX;
    nodeB.gyroY = packet.gyroY;
    nodeB.gyroZ = packet.gyroZ;
    nodeB.roll = packet.roll;
    nodeB.pitch = packet.pitch;
    nodeB.altitudeState = packet.altitudeState;
    nodeB.sequence = packet.sequence;
    nodeB.lastReceived = millis();
    
    sendToProcessing("B", packet);
  }
}

// ============================================================
// SEND TO PROCESSING
// ============================================================

void sendToProcessing(const char* node, SensorPacket &packet) {
  Serial.print("DATA:");
  Serial.print(node);
  Serial.print(":");
  Serial.print(packet.gyroX, 3);
  Serial.print(",");
  Serial.print(packet.gyroY, 3);
  Serial.print(",");
  Serial.print(packet.gyroZ, 3);
  Serial.print(",");
  Serial.print(packet.roll, 2);
  Serial.print(",");
  Serial.print(packet.pitch, 2);
  Serial.print(",");
  Serial.print(packet.altitudeState);
  Serial.print(",");
  Serial.println(packet.sequence);
}

// ============================================================
// GET STATUS STRINGS
// ============================================================

String getAltitudeStatus(uint8_t state) {
  if (state == 1) return "INCREASED";
  if (state == 2) return "DEFORMED";
  return "NORMAL";
}

String getNodeStatus(NodeData &node) {
  if (!node.received) return "WAITING";
  if (millis() - node.lastReceived > 2000) return "OFFLINE";
  
  // Check altitude state
  if (node.altitudeState == 2) return "CRITICAL";
  if (node.altitudeState == 1) return "WARNING";
  
  // Check tilt
  float rollChange = fabs(node.roll);
  float pitchChange = fabs(node.pitch);
  
  if (rollChange >= 8.0 || pitchChange >= 5.0) return "CRITICAL";
  if (rollChange >= 3.0 || pitchChange >= 2.0) return "WARNING";
  
  return "STABLE";
}

