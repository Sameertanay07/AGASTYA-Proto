// ============================================================
// NODE A - AZURE IOT KIT
// COM PORT: COM12
//
// ROLE:
//   IMU SENSOR NODE A + FBM320 BAROMETRIC ALTITUDE NODE
//
// CALIBRATION:
//   Gyro: 3 seconds
//   FBM320: 15 seconds (dedicated)
//
// UPDATE RATES:
//   Gyro: 100ms (ultra low latency - 10Hz)
//   FBM320: 1000ms (accurate - 1Hz)
// ============================================================

// ============================================================
// I2C
// ============================================================

#define SDA_PIN 25
#define SCL_PIN 26

#define MPU_ADDRESS 0x68

// FBM320
#define FBM320_ADDR     0x6D
#define WHO_AM_I_REG    0x6B
#define CONFIG_REG      0xF4
#define RESULT_REG      0xF6

// ============================================================
// ESP-NOW
// ============================================================

#define ESPNOW_CHANNEL 1

// ============================================================
// FBM320 CONFIGURATION
// ============================================================

#define SAMPLES_PER_READING        10
#define BASELINE_SAMPLES           30
#define DEFORMATION_THRESHOLD_CM   15.0

// ============================================================
// NODE C MAC ADDRESS
// ============================================================

uint8_t nodeCMAC[] = {
  0x30, 0xAE, 0xA4, 0xC9, 0xF9, 0x4C
};

// ============================================================
// NODE ID
// ============================================================

const char NODE_ID[] = "NODE_A";

// ============================================================
// MPU6050
// ============================================================

Adafruit_MPU6050 mpu;

// ============================================================
// RAW SENSOR DATA
// ============================================================

float gx = 0.0;
float gy = 0.0;
float gz = 0.0;

float ax = 0.0;
float ay = 0.0;
float az = 0.0;

// ============================================================
// GYRO BIAS
// ============================================================

float biasX = 0.0;
float biasY = 0.0;
float biasZ = 0.0;

float sumX = 0.0;
float sumY = 0.0;
float sumZ = 0.0;

uint32_t samples = 0;

// ============================================================
// ORIENTATION
// ============================================================

float roll = 0.0;
float pitch = 0.0;

// ============================================================
// ACCELEROMETER ANGLES
// ============================================================

float accelRoll = 0.0;
float accelPitch = 0.0;

// ============================================================
// TIMING
// ============================================================

unsigned long calibrationStart;
unsigned long previousMicros;
unsigned long lastAltUpdate = 0;
unsigned long lastGyroSend = 0;

// ============================================================
// CALIBRATION STATUS
// ============================================================

bool gyroCalibrated = false;
bool pressureCalibrated = false;

// ============================================================
// FBM320 CALIBRATION COEFFICIENTS
// ============================================================

int32_t C0, C1, C2, C3, C4, C5, C6;
int32_t C7, C8, C9, C10, C11, C12;

// ============================================================
// ALTITUDE DATA
// ============================================================

float baselinePressureA = 0.0;
float currentPressure = 0.0;
float relativeHeightCM = 0.0;

// Altitude state: 0=STABLE, 1=INCREASED, 2=DEFORMED
uint8_t altitudeState = 0;

// Node C baseline
float nodeCBaselinePressure = 0.0;
bool nodeCBaselineReceived = false;

// ============================================================
// COMPLEMENTARY FILTER (0.99 = faster response)
// ============================================================

const float ALPHA = 0.99;

// ============================================================
// DATA PACKET
// ============================================================

typedef struct {
  char nodeID[8];
  uint32_t sequence;
  uint32_t timestamp;
  
  float gyroX;
  float gyroY;
  float gyroZ;
  
  float roll;
  float pitch;
  float yaw;
  
  // Altitude fields
  uint8_t altitudeState;
  float relativeHeightCM;
  float baselinePressure;
  
} SensorPacket;

SensorPacket packet;

// ============================================================
// SEQUENCE
// ============================================================

uint32_t sequenceNumber = 0;

// ============================================================
// ESP-NOW CALLBACK (SEND)
// ============================================================

void onDataSent(const uint8_t *mac, esp_now_send_status_t status) {
  // Silent
}

// ============================================================
// ESP-NOW CALLBACK (RECEIVE)
// ============================================================

void onDataRecv(const esp_now_recv_info_t *info, const uint8_t *data, int len) {
  if (len != sizeof(SensorPacket)) return;
  
  SensorPacket incoming;
  memcpy(&incoming, data, sizeof(SensorPacket));
  
  if (strcmp(incoming.nodeID, "NODE_C") == 0) {
    if (incoming.baselinePressure > 0) {
      nodeCBaselinePressure = incoming.baselinePressure;
      nodeCBaselineReceived = true;
    }
  }
}

// ============================================================
// WIFI SETUP
// ============================================================

void setupWiFi() {
  WiFi.mode(WIFI_STA);
  delay(100);
  
  esp_wifi_set_channel(ESPNOW_CHANNEL, WIFI_SECOND_CHAN_NONE);
  
  Serial.print("Node A MAC: ");
  Serial.println(WiFi.macAddress());
}

// ============================================================
// ESP-NOW SETUP
// ============================================================

void setupESPNow() {
  if (esp_now_init() != ESP_OK) {
    Serial.println("ERROR: ESP-NOW INIT FAILED");
    while (true) { delay(1000); }
  }
  
  esp_now_register_send_cb(onDataSent);
  esp_now_register_recv_cb(onDataRecv);
  
  esp_now_peer_info_t peerInfo = {};
  memcpy(peerInfo.peer_addr, nodeCMAC, 6);
  peerInfo.channel = ESPNOW_CHANNEL;
  peerInfo.encrypt = false;
  
  if (esp_now_add_peer(&peerInfo) != ESP_OK) {
    Serial.println("ERROR: FAILED TO ADD NODE C");
    while (true) { delay(1000); }
  }
  
  Serial.println("ESP-NOW READY");
}

// ============================================================
// MPU SETUP
// ============================================================

void setupMPU() {
  Wire.begin(SDA_PIN, SCL_PIN);
  Wire.setClock(400000);
  
  if (!mpu.begin(MPU_ADDRESS, &Wire)) {
    Serial.println("ERROR: MPU6050 NOT FOUND");
    while (true) { delay(1000); }
  }
  
  mpu.setGyroRange(MPU6050_RANGE_250_DEG);
  mpu.setAccelerometerRange(MPU6050_RANGE_2_G);
  mpu.setFilterBandwidth(MPU6050_BAND_44_HZ);  // Faster filter for low latency
  
  Serial.println("MPU6050 READY");
}

// ============================================================
// FBM320: I2C WRITE
// ============================================================

bool fbmWrite(uint8_t reg, uint8_t value) {
  Wire.beginTransmission(FBM320_ADDR);
  Wire.write(reg);
  Wire.write(value);
  return (Wire.endTransmission() == 0);
}

// ============================================================
// FBM320: I2C READ
// ============================================================

bool fbmRead(uint8_t reg, uint8_t *buffer, uint8_t length) {
  Wire.beginTransmission(FBM320_ADDR);
  Wire.write(reg);
  
  if (Wire.endTransmission(false) != 0) return false;
  
  uint8_t received = Wire.requestFrom(FBM320_ADDR, length);
  if (received != length) return false;
  
  for (uint8_t i = 0; i < length; i++) {
    buffer[i] = Wire.read();
  }
  
  return true;
}

// ============================================================
// FBM320: READ 24-BIT ADC
// ============================================================

bool fbmReadADC(int32_t &result) {
  uint8_t data[3];
  
  if (!fbmRead(RESULT_REG, data, 3)) return false;
  
  result = ((int32_t)data[0] << 16) | 
           ((int32_t)data[1] << 8) | 
           data[2];
  
  return true;
}

// ============================================================
// FBM320: INITIALIZE
// ============================================================

bool initFBM320() {
  uint8_t id;
  
  if (!fbmRead(WHO_AM_I_REG, &id, 1)) return false;
  
  Serial.print("FBM320 ID = 0x");
  Serial.println(id, HEX);
  
  if (id != 0x42) {
    Serial.println("ERROR: FBM320 ID mismatch!");
    return false;
  }
  
  uint8_t Rdata[20];
  
  if (!fbmRead(0xAA, Rdata, 18)) return false;
  if (!fbmRead(0xD0, &Rdata[18], 1)) return false;
  if (!fbmRead(0xF1, &Rdata[19], 1)) return false;
  
  uint16_t R[10];
  
  for (int i = 0; i < 10; i++) {
    R[i] = ((uint16_t)Rdata[2 * i] << 8) | Rdata[2 * i + 1];
  }
  
  C0 = R[0] >> 4;
  C1 = ((R[1] & 0xFF00) >> 5) | (R[2] & 0x07);
  C2 = ((R[1] & 0xFF) << 1) | (R[4] & 0x01);
  C3 = R[2] >> 3;
  C5 = R[4] >> 1;
  C6 = R[5] >> 3;
  C8 = R[7] >> 3;
  C9 = R[8] >> 2;
  C10 = ((R[9] & 0xFF00) >> 6) | (R[8] & 0x03);
  C11 = R[9] & 0xFF;
  C4 = ((uint32_t)R[3] << 2) | (R[0] & 0x03);
  C7 = ((uint32_t)R[6] << 3) | (R[5] & 0x07);
  C12 = ((R[0] & 0x0C) << 1) | (R[7] & 0x07);
  
  fbmWrite(CONFIG_REG, 0x2E);
  delay(10);
  
  Serial.println("FBM320 calibration loaded.");
  return true;
}

// ============================================================
// FBM320: READ PRESSURE
// ============================================================

bool fbmReadPressure(float &pressurePa) {
  int32_t temperatureRaw;
  int32_t pressureRaw;
  
  if (!fbmWrite(CONFIG_REG, 0x2E)) return false;
  delay(10);
  if (!fbmReadADC(temperatureRaw)) return false;
  
  if (!fbmWrite(CONFIG_REG, 0xB4)) return false;
  delay(10);
  if (!fbmReadADC(pressureRaw)) return false;
  
  int32_t X01, X02, X03;
  int32_t X11, X12, X13;
  int32_t X21, X22, X23, X24, X25, X26;
  int32_t PP1, PP2, PP3, PP4;
  int32_t CF, DT, DT2;
  
  DT = ((temperatureRaw - 8388608L) >> 4) + (C0 << 4);
  
  X01 = ((C1 + 4459L) * DT) >> 1;
  X02 = ((((C2 - 256L) * DT) >> 14) * DT) >> 4;
  X03 = (((((C3 * DT) >> 18) * DT) >> 18) * DT);
  
  DT2 = (X01 + X02 + X03) >> 12;
  
  X11 = (C5 - 4443L) * DT2;
  X12 = (((C6 * DT2) >> 16) * DT2) >> 2;
  X13 = ((X11 + X12) >> 10) + ((C4 + 120586L) << 4);
  
  X21 = ((C8 + 7180L) * DT2) >> 10;
  X22 = (((C9 * DT2) >> 17) * DT2) >> 12;
  X23 = abs(X22 - X21);
  X24 = (X23 >> 11) * (C7 + 166426L);
  X25 = ((X23 & 0x7FF) * (C7 + 166426L)) >> 11;
  
  if (X21 >= X22) {
    X26 = (((0 - X24 - X25) >> 11) + C7 + 166426L);
  } else {
    X26 = (((X24 + X25) >> 11) + C7 + 166426L);
  }
  
  PP1 = ((pressureRaw - 8388608L) - X13) >> 3;
  PP2 = (X26 >> 11) * PP1;
  PP3 = ((X26 & 0x7FF) * PP1) >> 11;
  PP4 = (PP2 + PP3) >> 10;
  
  CF = (2097152L + C12 * DT2) >> 3;
  
  int32_t X31 = (((CF * C10) >> 17) * PP4) >> 2;
  int32_t X32 = (((((CF * C11) >> 15) * PP4) >> 18) * PP4);
  
  pressurePa = (float)(((X31 + X32) >> 15) + PP4 + 99880L);
  
  return true;
}

// ============================================================
// FBM320: AVERAGE PRESSURE
// ============================================================

float fbmAveragePressure() {
  float sum = 0;
  int valid = 0;
  
  for (int i = 0; i < SAMPLES_PER_READING; i++) {
    float p;
    if (fbmReadPressure(p)) {
      sum += p;
      valid++;
    }
    delay(50);
  }
  
  if (valid == 0) return -1;
  return sum / valid;
}

// ============================================================
// ALTITUDE: RELATIVE HEIGHT
// ============================================================

float relativeHeightM(float currentPressure, float referencePressure) {
  return 44330.0f * (1.0f - pow(currentPressure / referencePressure, 0.190294957f));
}

// ============================================================
// ALTITUDE: EVALUATE STATE
// ============================================================

uint8_t evaluateAltitudeState(float pressureA, float baselineA, float baselineC) {
  float heightA = relativeHeightM(pressureA, baselineA);
  float heightC = relativeHeightM(baselineC, baselineA);
  float diff = heightA - heightC;
  
  float thresholdM = DEFORMATION_THRESHOLD_CM / 100.0f;
  
  if (diff >= thresholdM) return 1;
  if (diff <= -thresholdM) return 2;
  return 0;
}

// ============================================================
// SETUP
// ============================================================

void setup() {
  Serial.begin(115200);
  delay(1000);
  
  Serial.println();
  Serial.println("========================================");
  Serial.println("     NODE A - AZURE KIT + FBM320");
  Serial.println("          COM PORT: COM12");
  Serial.println("========================================");
  
  setupWiFi();
  setupMPU();
  
  Serial.println();
  Serial.println("INITIALIZING FBM320...");
  
  if (!initFBM320()) {
    Serial.println("FBM320 NOT DETECTED");
    while (true) { delay(1000); }
  }
  
  setupESPNow();
  
  calibrationStart = millis();
  previousMicros = micros();
  
  Serial.println();
  Serial.println("========================================");
  Serial.println("   PHASE 1: GYRO CALIBRATION (3 SEC)");
  Serial.println("========================================");
  Serial.println("KEEP NODE A COMPLETELY STATIONARY");
}

// ============================================================
// READ MPU6050
// ============================================================

void readMPU() {
  sensors_event_t accel;
  sensors_event_t gyro;
  sensors_event_t temperature;
  
  mpu.getEvent(&accel, &gyro, &temperature);
  
  ax = accel.acceleration.x;
  ay = accel.acceleration.y;
  az = accel.acceleration.z;
  
  gx = gyro.gyro.x;
  gy = gyro.gyro.y;
  gz = gyro.gyro.z;
}

// ============================================================
// GYRO CALIBRATION (3 seconds)
// ============================================================

void calibrateGyro() {
  sumX += gx;
  sumY += gy;
  sumZ += gz;
  samples++;
  
  unsigned long elapsed = millis() - calibrationStart;
  
  if (elapsed >= 3000) {
    biasX = sumX / samples;
    biasY = sumY / samples;
    biasZ = sumZ / samples;
    
    accelRoll = atan2(ay, az) * 57.2957795f;
    accelPitch = atan2(-ax, sqrt(ay * ay + az * az)) * 57.2957795f;
    
    roll = accelRoll;
    pitch = accelPitch;
    
    gyroCalibrated = true;
    previousMicros = micros();
    calibrationStart = millis();
    
    Serial.println();
    Serial.println("========================================");
    Serial.println("   GYRO CALIBRATION COMPLETE");
    Serial.println("========================================");
    Serial.print("Bias X = "); Serial.println(biasX, 6);
    Serial.print("Bias Y = "); Serial.println(biasY, 6);
    Serial.print("Bias Z = "); Serial.println(biasZ, 6);
    
    Serial.println();
    Serial.println("========================================");
    Serial.println("  PHASE 2: FBM320 BASELINE (15 SEC)");
    Serial.println("========================================");
    Serial.println("Keep Node A stationary...");
    Serial.println("Taking 30 averaged readings...");
  }
}

// ============================================================
// FBM320 BASELINE CALIBRATION (15 seconds)
// ============================================================

void calibratePressureBaseline() {
  static int baselineCount = 0;
  static float pressureSum = 0;
  static int validSamples = 0;
  
  float pressure = fbmAveragePressure();
  
  if (pressure > 0) {
    pressureSum += pressure;
    validSamples++;
  }
  
  baselineCount++;
  
  if (baselineCount % 5 == 0) {
    Serial.print("Calibration: ");
    Serial.print(baselineCount);
    Serial.print("/");
    Serial.println(BASELINE_SAMPLES);
  }
  
  if (baselineCount >= BASELINE_SAMPLES) {
    if (validSamples == 0) {
      Serial.println("ERROR: Pressure baseline failed!");
      while (true) { delay(1000); }
    }
    
    baselinePressureA = pressureSum / validSamples;
    pressureCalibrated = true;
    
    Serial.println();
    Serial.println("========================================");
    Serial.println("   FBM320 BASELINE ESTABLISHED");
    Serial.println("========================================");
    Serial.print("Baseline Pressure: ");
    Serial.print(baselinePressureA, 2);
    Serial.println(" Pa");
    Serial.println("Relative height = 0 cm");
    
    Serial.println();
    Serial.println("========================================");
    Serial.println("   NODE A MONITORING STARTED");
    Serial.println("========================================");
  }
}

// ============================================================
// UPDATE ORIENTATION (Runs every loop for smoothness)
// ============================================================

void updateOrientation() {
  unsigned long currentMicros = micros();
  float dt = (currentMicros - previousMicros) / 1000000.0f;
  previousMicros = currentMicros;
  
  if (dt <= 0 || dt > 0.1f) return;
  
  float correctedGX = gx - biasX;
  float correctedGY = gy - biasY;
  
  accelRoll = atan2(ay, az) * 57.2957795f;
  accelPitch = atan2(-ax, sqrt(ay * ay + az * az)) * 57.2957795f;
  
  float gyroRollRate = correctedGX * 57.2957795f;
  float gyroPitchRate = correctedGY * 57.2957795f;
  
  roll = ALPHA * (roll + gyroRollRate * dt) + (1.0f - ALPHA) * accelRoll;
  pitch = ALPHA * (pitch + gyroPitchRate * dt) + (1.0f - ALPHA) * accelPitch;
}

// ============================================================
// UPDATE ALTITUDE (1 second - accurate)
// ============================================================

void updateAltitude() {
  currentPressure = fbmAveragePressure();
  
  if (currentPressure <= 0) return;
  
  if (nodeCBaselineReceived) {
    altitudeState = evaluateAltitudeState(
      currentPressure,
      baselinePressureA,
      nodeCBaselinePressure
    );
    
    float heightA = relativeHeightM(currentPressure, baselinePressureA);
    float heightC = relativeHeightM(nodeCBaselinePressure, baselinePressureA);
    relativeHeightCM = (heightA - heightC) * 100.0f;
    
  } else {
    float heightA = relativeHeightM(currentPressure, baselinePressureA);
    relativeHeightCM = heightA * 100.0f;
    
    if (relativeHeightCM >= DEFORMATION_THRESHOLD_CM) {
      altitudeState = 1;
    } else if (relativeHeightCM <= -DEFORMATION_THRESHOLD_CM) {
      altitudeState = 2;
    } else {
      altitudeState = 0;
    }
  }
}

// ============================================================
// BUILD PACKET
// ============================================================

void buildPacket() {
  memset(&packet, 0, sizeof(packet));
  
  strncpy(packet.nodeID, NODE_ID, sizeof(packet.nodeID) - 1);
  
  packet.sequence = sequenceNumber++;
  packet.timestamp = millis();
  
  packet.gyroX = gx - biasX;
  packet.gyroY = gy - biasY;
  packet.gyroZ = gz - biasZ;
  
  packet.roll = roll;
  packet.pitch = pitch;
  packet.yaw = 0.0f;
  
  packet.altitudeState = altitudeState;
  packet.relativeHeightCM = relativeHeightCM;
  packet.baselinePressure = 0.0f;
}

// ============================================================
// SEND PACKET
// ============================================================

void sendPacket() {
  esp_now_send(nodeCMAC, (uint8_t *)&packet, sizeof(packet));
}

// ============================================================
// SERIAL DEBUG (100ms - ultra smooth)
// ============================================================

void printDebug() {
  static unsigned long lastPrint = 0;
  
  if (millis() - lastPrint < 100) return;
  lastPrint = millis();
  
  Serial.print("DATA:");
  Serial.print(roll, 2);
  Serial.print(",");
  Serial.print(pitch, 2);
  Serial.print(",");
  Serial.print(gx - biasX, 3);
  Serial.print(",");
  Serial.print(gy - biasY, 3);
  Serial.print(",");
  Serial.print(gz - biasZ, 3);
  Serial.print(",");
  Serial.print(relativeHeightCM, 2);
  Serial.print(",");
  Serial.print(altitudeState);
  Serial.print(",");
  Serial.println(sequenceNumber - 1);
}

// ============================================================
// MAIN LOOP
// ============================================================

void loop() {
  readMPU();
  
  // Phase 1: Gyro calibration (3 seconds)
  if (!gyroCalibrated) {
    calibrateGyro();
    delay(5);
    return;
  }
  
  // Phase 2: FBM320 baseline calibration (15 seconds)
  if (!pressureCalibrated) {
    calibratePressureBaseline();
    return;
  }
  
  // Phase 3: Normal operation
  updateOrientation();
  
  // Update altitude every 1 second (accurate)
  if (millis() - lastAltUpdate >= 1000) {
    lastAltUpdate = millis();
    updateAltitude();
  }
  
  // Send gyro data every 100ms (ultra low latency)
  if (millis() - lastGyroSend >= 100) {
    lastGyroSend = millis();
    buildPacket();
    sendPacket();
  }
  
  printDebug();
}
